{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "seed:learning": "ts-node scripts/learning/seed-learning.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test,scripts}/**/*.ts\"",
    "format:check": "prettier --check \"{src,test,scripts}/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:db:p0": "ts-node scripts/test/run-p0-schema-integration.ts",
    "test:db:activity-integrity": "ts-node scripts/test/run-lesson-activity-integrity.ts",
    "test:db:activity-concurrency": "ts-node scripts/test/run-lesson-activity-concurrency.ts",
    "test:db:exercise-concurrency": "ts-node scripts/test/run-exercise-authoring-concurrency.ts",
    "test:db:exercise-integrity": "ts-node scripts/test/run-exercise-authoring-integrity.ts",
    "test:db:media-integrity": "ts-node scripts/test/run-media-ingestion-integrity.ts",
    "test:db:media-migration": "node --test -r ts-node/register scripts/test/media-lifecycle-migration-validation.helpers.spec.ts && ts-node scripts/test/run-media-lifecycle-migration-validation.ts",
    "test:db:media-migration:release": "node --test -r ts-node/register scripts/test/media-lifecycle-migration-validation.helpers.spec.ts && ts-node scripts/test/run-media-lifecycle-migration-release-validation.ts",
    "test:ops:media": "npm run test:ops:media:unit && ts-node scripts/test/run-media-operations-validation.ts",
    "test:ops:media:reference": "npm run test:ops:media",
    "test:ops:media:linux-amd64": "npm run test:ops:media:unit && ts-node scripts/test/run-media-operations-validation.ts --profile=release-linux-amd64",
    "test:ops:media:unit": "node --test -r ts-node/register scripts/test/media-operations-validation.helpers.spec.ts",
    "test:security:secrets": "node --test -r ts-node/register scripts/security/secret-scan.spec.ts && ts-node scripts/security/run-secret-scan.ts",
    "render:ops:media": "ts-node scripts/operations/render-media-observability.ts",
    "test:db:concurrency": "ts-node scripts/test/run-p0-integrity-concurrency.ts",
    "test:db:cms-concurrency": "ts-node scripts/test/run-cms-lifecycle-concurrency.ts",
    "test:seed:frontend-console": "ts-node scripts/test/seed-frontend-admin-console.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.883.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.29",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^5.22.0",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "joi": "^18.2.1",
    "music-metadata": "^11.8.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prisma": "^5.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.12.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "overrides": {
    "body-parser": "2.3.0",
    "qs": "6.15.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.spec.json"
        }
      ]
    },
    "testEnvironmentOptions": {
      "customExportConditions": [
        "node",
        "node-addons"
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
