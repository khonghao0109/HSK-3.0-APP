NODE_ENV=development
PORT=3000

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/hsk_system?schema=public"
# For write tests, set NODE_ENV=test and override DATABASE_URL so it points to
# this exact disposable database (DATABASE_URL may keep ?schema=public).
# The test name must end in test/e2e/verify/disposable/hardening, optionally
# followed by a numeric timestamp/suffix. TEST_DATABASE_URL is passed to psql,
# so keep it free of Prisma-only query parameters such as `?schema=public`.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/hsk_system_test"

JWT_SECRETS="{\"v1\":\"change-me-at-least-32-characters\"}"
JWT_ACTIVE_KID="v1"
JWT_EXPIRES_IN="7d"
AUTH_PASSWORD_PEPPER="change-me-at-least-16-characters"
