NODE_ENV=development
PORT=3000

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/hsk_system?schema=public"
# For write tests, set NODE_ENV=test and override DATABASE_URL so it points to
# this exact disposable database (DATABASE_URL may keep ?schema=public).
# The test name must end in test/e2e/verify/disposable/hardening, optionally
# followed by a numeric timestamp/suffix. TEST_DATABASE_URL is passed to psql,
# so keep it free of Prisma-only query parameters such as `?schema=public`.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/hsk_system_test"

JWT_SECRETS="{\"v1\":\"change-me-at-least-32-characters\"}"
JWT_ACTIVE_KID="v1"
JWT_EXPIRES_IN="7d"
AUTH_PASSWORD_PEPPER="change-me-at-least-16-characters"

# Private object storage. Prefer workload identity/instance roles instead of
# long-lived access keys. Endpoint is optional and must be HTTPS when provided.
MEDIA_STORAGE_BUCKET="hsk-private-media"
MEDIA_STORAGE_REGION="ap-southeast-1"
# MEDIA_STORAGE_ENDPOINT="https://object-storage.example.com"
MEDIA_SIGNING_SECRET="change-me-at-least-32-characters"
MEDIA_ACCESS_TTL_SECONDS=300
MEDIA_SCANNER_HOST="clamav"
MEDIA_SCANNER_PORT=3310
# Fail-closed upload kill switch. Cleanup and reconciliation remain available.
MEDIA_INGESTION_ENABLED=false
# Scrape credential; provision from a secret manager and never log it.
MEDIA_METRICS_BEARER_TOKEN="change-me-at-least-32-characters"
