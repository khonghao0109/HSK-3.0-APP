    {
      "key": "t02",
      "type": "grammar",
      "title": "Ngữ pháp (1/2): 会/能/想 + động từ · Bổ ngữ kết quả 到/见",
      "subtitle": "Ba điểm ngữ pháp để nói biết, có thể, muốn làm gì và đã nhìn thấy, nghe thấy chưa",
      "orderIndex": 3,
      "isPremium": false,
      "isLocked": false,
      "content": [
        {
          "type": "grammar_point",
          "title": "会/能/想 + động từ",
          "formula": [
            {
              "role": "subj",
              "zh": "主语",
              "vi": "Chủ ngữ"
            },
            {
              "role": "key",
              "zh": "会",
              "vi": "Trợ động từ"
            },
            {
              "role": "verb",
              "zh": "动词",
              "vi": "Động từ"
            },
            {
              "role": "other",
              "zh": "(宾语)",
              "vi": "(Tân ngữ)"
            }
          ],
          "explanation": "ba động từ năng nguyện đứng trước động từ chính. 会 = biết làm (kỹ năng học được), 能 = có thể (có điều kiện, có khả năng), 想 = muốn. Cấu trúc: Chủ ngữ + 会/能/想 + động từ (+ tân ngữ); phủ định thêm 不: 不会, 不能, 不想.",
          "examples": [
            {
              "hanzi": "我会唱歌。",
              "pinyin": "Wǒ huì chànggē.",
              "vi": "Tôi biết hát.",
              "highlight": "会"
            },
            {
              "hanzi": "明天我能去打球。",
              "pinyin": "Míngtiān wǒ néng qù dǎqiú.",
              "vi": "Ngày mai tôi có thể đi chơi bóng.",
              "highlight": "能"
            },
            {
              "hanzi": "我不想看电影。",
              "pinyin": "Wǒ bù xiǎng kàn diànyǐng.",
              "vi": "Tôi không muốn xem phim.",
              "highlight": "想"
            }
          ]
        },
        {
          "type": "grammar_point",
          "title": "Bổ ngữ kết quả 到/见",
          "formula": [
            {
              "role": "verb",
              "zh": "动词",
              "vi": "Động từ"
            },
            {
              "role": "key",
              "zh": "到",
              "vi": "Bổ ngữ"
            },
            {
              "role": "other",
              "zh": "(宾语)",
              "vi": "(Tân ngữ)"
            },
            {
              "role": "other",
              "zh": "了",
              "vi": "Trợ từ"
            }
          ],
          "explanation": "看 (nhìn) và 听 (nghe) chỉ nói hành động; thêm 到 hoặc 见 phía sau để nói đã có kết quả: 看到/看见 = nhìn thấy, 听到/听见 = nghe thấy. Cấu trúc: Động từ + 到/见 (+ tân ngữ) + 了; phủ định dùng 没 và bỏ 了: 没看见, 没听到.",
          "examples": [
            {
              "hanzi": "我看见他了。",
              "pinyin": "Wǒ kànjiàn tā le.",
              "vi": "Tôi nhìn thấy anh ấy rồi.",
              "highlight": "看见"
            },
            {
              "hanzi": "你听到了吗？",
              "pinyin": "Nǐ tīngdào le ma?",
              "vi": "Bạn nghe thấy chưa?",
              "highlight": "听到"
            },
            {
              "hanzi": "我没听见。",
              "pinyin": "Wǒ méi tīngjiàn.",
              "vi": "Tôi không nghe thấy.",
              "highlight": "听见"
            }
          ]
        }
      ]
    },
