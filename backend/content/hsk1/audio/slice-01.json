      "voice": "zh-CN-XiaoxiaoNeural",
      "text": "是"
    },
    {
      "sourceKey": "hsk1:l01:w09:ex",
      "voice": "zh-CN-YunxiNeural",
      "text": "我是中国人。"
    },
    {
      "sourceKey": "hsk1:l01:w10",
