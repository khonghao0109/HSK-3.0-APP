      "text": "我们"
    },
    {
      "sourceKey": "hsk1:l01:w06:ex",
      "voice": "zh-CN-XiaoxiaoNeural",
      "text": "我们都是学生。"
    },
    {
      "sourceKey": "hsk1:l01:w07",
      "voice": "zh-CN-XiaoxiaoNeural",
      "text": "叫"
    },
    {
      "sourceKey": "hsk1:l01:w07:ex",
